# Образец настроек для docker compose. Скопируйте: cp .env.example .env
# Описание переменных — spec/tech/architecture.md, раздел 7. Файл .env в git не попадает.
# Пустое значение означает значение по умолчанию сервера.

# Порт Nginx на компьютере: приложение открывается на http://localhost:<NGINX_PORT>
NGINX_PORT=80
# Порт сервера внутри сети Docker
SERVER_PORT=3000

# Корпус: demo — вымышленные записи DEMO-*; official — статьи из CORPUS_PATH.
# Для контрольной точки — срез из 30 статей (spec/tech/benchmark.md).
# Относительный путь отсчитывается от папки app/server.
CORPUS_MODE=official
CORPUS_PATH=data/benchmark/articles.json

# Поиск и контекст модели (spec/tech/rag.md)
MAX_CONTEXT_DOCS=5
MIN_SCORE=0
LLM_CONTEXT_BYTES=24000

# Языковая модель (README, раздел «Запуск»):
# openai_compatible — сервис с OpenAI-совместимым API; по умолчанию Cloud.ru Foundation Models;
# stub — без модели: вместо пояснения выдержка из найденной статьи, ключ не нужен.
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://foundation-models.api.cloud.ru/v1
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash
# Key Secret API-ключа Cloud.ru (вкладка «API-ключи», не «Ключи доступа»).
# Ключ — секрет: не записывайте его в код, документы и сообщения коммитов.
LLM_API_KEY=
LLM_TIMEOUT_MS=60000
